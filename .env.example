# Copy these values into your user environment or a local .env file.
# Never commit real API keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
LLM_MAX_CONCURRENT=2

# Neo4j credentials are required only for graph import or live graph retrieval.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
